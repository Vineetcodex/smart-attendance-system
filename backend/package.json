{
  "name": "attendance-backend",
  "version": "1.0.0",
  "description": "Automated QR & Facial Verification Attendance System Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run build:web && tsc",
